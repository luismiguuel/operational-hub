{
  "name": "@hub/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc",
    "start": "tsx --env-file=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/tests/*.test.ts",
    "test:integration": "tsx --env-file=../../.env --test src/tests/*.integration.ts",
    "db:migrate": "tsx --env-file=../../.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/scripts/seed.ts",
    "worker": "tsx --env-file=../../.env src/worker.ts"
  },
  "dependencies": {
    "@hub/shared": "workspace:*",
    "fastify": "^5.6.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.61.0",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "pg": "^8.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0"
  }
}
