# Set NODE_ENV=production in the production runtime environment.
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://hub:hub@localhost:5432/hub
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Secure cookies require HTTPS; localhost development is the only insecure exception.
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
GOOGLE_WORKSPACE_DOMAIN=
# First user, explicitly provisioned by db:seed (no public signup).
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=
SEED_DEMO=false
# Optional OpenAI-compatible provider. Empty key disables AI jobs (503).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Set these together with DATABASE_URL / REDIS_URL if default ports are occupied.
POSTGRES_PORT=5432
REDIS_PORT=6379
