{
  "name": "operational-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.tools.json && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm --filter @hub/api test",
    "db:migrate": "pnpm --filter @hub/api db:migrate",
    "db:seed": "pnpm --filter @hub/api db:seed",
    "worker": "pnpm --filter @hub/api worker",
    "test:integration": "pnpm --filter @hub/api test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.15.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
